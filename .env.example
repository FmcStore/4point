# ============================================================
#  Salin file ini menjadi `.env.local` lalu sesuaikan nilainya.
# ============================================================

# Password untuk masuk ke dashboard admin (/admin)
ADMIN_PASSWORD=4point-admin

# Kunci rahasia untuk cookie sesi admin (ganti dengan teks acak panjang)
ADMIN_SESSION_SECRET=ganti-dengan-teks-acak-panjang-anda

# Lokasi file database SQLite (relatif dari root project)
DB_PATH=./data/4point.db
